# nginx.conf - E-Arsip Digital 2026
# Enterprise Nginx Configuration for PWA
# Test: nginx -t && nginx -s reload

# ============================================
# MAIN CONTEXT
# ============================================
worker_processes auto;
worker_rlimit_nofile 65535;
pid /var/run/nginx.pid;
error_log /var/log/nginx/error.log warn;

# ============================================
# EVENTS
# ============================================
events {
    worker_connections 4096;
    use epoll;
    multi_accept on;
    accept_mutex off;
}

# ============================================
# HTTP
# ============================================
http {
    # Basic Settings
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    
    charset utf-8;
    charset_types text/css text/plain text/javascript application/javascript application/json;
    
    # Logging (JSON format for log aggregation)
    log_format json_combined escape=json '{'
        '"time_local":"$time_local",'
        '"remote_addr":"$remote_addr",'
        '"remote_user":"$remote_user",'
        '"request":"$request",'
        '"status":$status,'
        '"body_bytes_sent":$body_bytes_sent,'
        '"request_time":$request_time,'
        '"http_referrer":"$http_referer",'
        '"http_user_agent":"$http_user_agent",'
        '"http_x_forwarded_for":"$http_x_forwarded_for",'
        '"host":"$host",'
        '"upstream_response_time":"$upstream_response_time",'
        '"ssl_protocol":"$ssl_protocol",'
        '"ssl_cipher":"$ssl_cipher"'
    '}';
    
    access_log /var/log/nginx/access.log json_combined buffer=32k flush=5s;
    error_log /var/log/nginx/error.log warn;
    
    # Performance
    sendfile on;
    sendfile_max_chunk 512k;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    keepalive_requests 100;
    types_hash_max_size 2048;
    server_tokens off;
    server_name_in_redirect off;
    port_in_redirect off;
    
    # Timeouts
    client_body_timeout 12;
    client_header_timeout 12;
    send_timeout 10;
    reset_timedout_connection on;
    
    # Buffer Sizes
    client_body_buffer_size 16k;
    client_header_buffer_size 1k;
    client_max_body_size 10m;
    large_client_header_buffers 4 16k;
    
    # ============================================
    # COMPRESSION (Gzip + Brotli)
    # ============================================
    # Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_types
        text/plain text/css text/xml text/javascript text/csv
        application/javascript application/json application/xml
        application/rss+xml application/atom+xml
        application/manifest+json
        image/svg+xml image/x-icon
        font/ttf font/otf font/woff font/woff2;
    
    # Brotli (if ngx_brotli module available)
    # brotli on;
    # brotli_comp_level 6;
    # brotli_types text/plain text/css text/javascript application/javascript;
    
    # ============================================
    # CACHE SETTINGS
    # ============================================
    open_file_cache max=10000 inactive=30s;
    open_file_cache_valid 60s;
    open_file_cache_min_uses 2;
    open_file_cache_errors on;
    
    # ============================================
    # RATE LIMITING ZONES
    # ============================================
    limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=api:10m rate=30r/m;
    limit_req_zone $binary_remote_addr zone=general:10m rate=100r/m;
    limit_conn_zone $binary_remote_addr zone=addr:10m;
    
    # ============================================
    # UPSTREAM (Optional Backend)
    # ============================================
    # upstream backend {
    #     server localhost:3000;
    #     keepalive 32;
    # }
    
    # ============================================
    # VIRTUAL HOST (HTTP → HTTPS Redirect)
    # ============================================
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;
        
        # Health check (no redirect)
        location /health {
            access_log off;
            return 200 '{"status":"healthy","version":"2026.1.0"}\n';
            add_header Content-Type application/json;
        }
        
        # ACME challenge for Let's Encrypt
        location ^~ /.well-known/acme-challenge/ {
            root /var/www/certbot;
            default_type text/plain;
        }
        
        # Redirect all other HTTP to HTTPS
        location / {
            return 301 https://$host$request_uri;
        }
    }
    
    # ============================================
    # VIRTUAL HOST (HTTPS)
    # ============================================
    server {
        listen 443 ssl http2;
        listen [::]:443 ssl http2;
        server_name e-arsip.example.com;
        
        # SSL Configuration
        ssl_certificate /etc/letsencrypt/live/e-arsip.example.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/e-arsip.example.com/privkey.pem;
        ssl_trusted_certificate /etc/letsencrypt/live/e-arsip.example.com/chain.pem;
        
        # SSL Protocols & Ciphers
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:50m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;
        
        # OCSP Stapling
        ssl_stapling on;
        ssl_stapling_verify on;
        ssl_stapling_file /etc/letsencrypt/live/e-arsip.example.com/ocsp.der;
        resolver 8.8.8.8 8.8.4.4 valid=300s;
        resolver_timeout 5s;
        
        # HSTS (31536000 = 1 year)
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        
        # Document Root
        root /usr/share/nginx/html;
        index index.html;
        
        # ============================================
        # GLOBAL SECURITY HEADERS
        # ============================================
        add_header Content-Security-Policy "\
            default-src 'self';\
            script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://script.google.com https://script.googleusercontent.com;\
            style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com;\
            font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net;\
            img-src 'self' data: blob: https:;\
            connect-src 'self' https://script.google.com https://script.googleusercontent.com https://*.googleapis.com;\
            frame-src 'none';\
            object-src 'none';\
            base-uri 'self';\
            form-action 'self';\
            manifest-src 'self';\
            worker-src 'self' blob:;\
        " always;
        
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "\
            camera=(),\
            microphone=(),\
            geolocation=(),\
            payment=(),\
            usb=(),\
            bluetooth=(),\
            ambient-light-sensor=(),\
            accelerometer=(),\
            gyroscope=(),\
            magnetometer=()\
        " always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        
        # Remove sensitive headers
        proxy_hide_header X-Powered-By;
        fastcgi_hide_header X-Powered-By;
        more_clear_headers Server;
        
        # ============================================
        # RATE LIMITING
        # ============================================
        limit_req zone=general burst=20 nodelay;
        limit_conn addr 20;
        
        # ============================================
        # LOCATION BLOCKS
        # ============================================
        
        # Health Check
        location = /health {
            access_log off;
            return 200 '{"status":"healthy","version":"2026.1.0","timestamp":"$time_iso8601"}\n';
            add_header Content-Type application/json;
            add_header Cache-Control "no-cache";
        }
        
        # Security.txt
        location = /security.txt {
            access_log off;
            return 200 "Contact: mailto:security@e-arsip.id\nExpires: 2027-12-31T23:59:59Z\nPreferred-Languages: id, en\n";
            add_header Content-Type text/plain;
        }
        
        # Well-known (for ACME, security, etc.)
        location ^~ /.well-known/ {
            allow all;
            root /usr/share/nginx/html;
            expires 1h;
        }
        
        # Favicon & Robots
        location = /favicon.ico {
            access_log off;
            log_not_found off;
            expires 30d;
            try_files /favicon.ico /icons/favicon.ico =404;
        }
        
        location = /robots.txt {
            access_log off;
            log_not_found off;
            expires 1d;
        }
        
        # Login - Stricter Rate Limit
        location = /login.html {
            limit_req zone=login burst=3 nodelay;
            expires -1;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }
        
        # ============================================
        # API PROXY (Google Apps Script)
        # ============================================
        location /api/ {
            limit_req zone=api burst=10 nodelay;
            
            # Proxy to Google Apps Script
            proxy_pass https://script.google.com/macros/s/${GOOGLE_SCRIPT_ID}/;
            proxy_http_version 1.1;
            
            # Headers
            proxy_set_header Host script.google.com;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Connection "";
            
            # Timeouts
            proxy_connect_timeout 30s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            
            # Buffering
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 8 16k;
            proxy_busy_buffers_size 32k;
            
            # CORS
            add_header Access-Control-Allow-Origin "https://$host" always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-CSRF-Token, X-Requested-With" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Max-Age "3600" always;
            
            # Handle OPTIONS preflight
            if ($request_method = 'OPTIONS') {
                add_header Content-Length 0;
                return 204;
            }
            
            # No cache for API responses
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }
        
        # ============================================
        # STATIC ASSETS WITH CACHING
        # ============================================
        
        # CSS & JavaScript (1 year - version hashed)
        location ~* \.(css|js)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
            try_files $uri =404;
        }
        
        # Fonts (1 year)
        location ~* \.(woff|woff2|ttf|eot|otf)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
            add_header Access-Control-Allow-Origin "*";
            try_files $uri =404;
        }
        
        # Images (30 days)
        location ~* \.(jpg|jpeg|png|gif|webp|avif)$ {
            expires 30d;
            add_header Cache-Control "public";
            access_log off;
            try_files $uri =404;
        }
        
        # SVG & Icons (1 year)
        location ~* \.(svg|ico)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
            try_files $uri =404;
        }
        
        # Web App Manifest (1 week)
        location = /manifest.json {
            expires 7d;
            add_header Cache-Control "public";
            add_header Content-Type application/manifest+json;
        }
        
        # Service Worker (Never cached)
        location = /sw.js {
            expires off;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Service-Worker-Allowed "/";
            add_header Content-Type text/javascript;
        }
        
        # HTML Pages (1 hour - for content freshness)
        location ~* \.html$ {
            expires 1h;
            add_header Cache-Control "public, must-revalidate";
            try_files $uri =404;
        }
        
        # ============================================
        # BLOCK SENSITIVE PATHS
        # ============================================
        
        # Config files
        location ~* /config/ {
            deny all;
            return 403;
        }
        
        # Environment files
        location ~* \.env(\..*)?$ {
            deny all;
            return 403;
        }
        
        # Backup & database files
        location ~* \.(backup|bak|sql|sql\.gz|tar|tar\.gz|tgz|zip|7z)$ {
            deny all;
            return 403;
        }
        
        # Log files
        location ~* \.log$ {
            deny all;
            return 403;
        }
        
        # Google Apps Script files
        location ~* \.gs$ {
            deny all;
            return 403;
        }
        
        # Hidden files and directories
        location ~ /\. {
            deny all;
            return 403;
        }
        
        # Source control
        location ~* /\.git {
            deny all;
            return 403;
        }
        
        # Package files
        location ~* /(package\.json|package-lock\.json|yarn\.lock|composer\.json|composer\.lock)$ {
            deny all;
            return 403;
        }
        
        # ============================================
        # SPA FALLBACK
        # ============================================
        location / {
            try_files $uri $uri/ /index.html;
            
            # For PWA: add Link header for preload
            # add_header Link "</sw.js>; rel=serviceworker" always;
        }
        
        # ============================================
        # ERROR PAGES
        # ============================================
        error_page 400 401 403 404 /404.html;
        error_page 500 502 503 504 /500.html;
        
        location = /404.html {
            internal;
            expires -1;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }
        
        location = /500.html {
            internal;
            expires -1;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }
    }
}