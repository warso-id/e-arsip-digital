{
  "name": "e-arsip-digital",
  "version": "2026.1.0",
  "description": "Sistem Manajemen Arsip Digital Modern - Enterprise Document Management System",
  "private": true,
  "type": "module",
  "main": "index.html",
  "files": [
    "*.html",
    "css/",
    "js/",
    "config/",
    "components/",
    "icons/",
    "screenshots/",
    "sw.js",
    "manifest.json",
    "robots.txt",
    ".htaccess"
  ],
  "exports": {
    ".": "./index.html",
    "./js/*": "./js/*.js",
    "./config/*": "./config/*.js"
  },
  "scripts": {
    "dev": "npx http-server . -p 8080 -c-1 --cors --gzip --brotli",
    "dev:https": "npx http-server . -p 8080 -c-1 --cors --gzip --ssl --cert cert.pem --key key.pem",
    "start": "npx http-server . -p 8080 -c-1",
    "preview": "npx http-server . -p 4173",
    "build": "npm run clean && npm run copy && npm run minify && npm run pwa",
    "copy": "node scripts/copy-build.js",
    "minify": "npm run minify:js && npm run minify:css && npm run minify:html",
    "minify:js": "npx terser js/*.js js/**/*.js -c -m --module -o dist/js/",
    "minify:css": "npx cleancss css/*.css -o dist/css/style.min.css",
    "minify:html": "npx html-minifier-terser --input-dir . --output-dir dist --file-ext html --remove-comments --collapse-whitespace --minify-css --minify-js",
    "pwa": "npm run pwa:icons && npm run pwa:sw",
    "pwa:icons": "node scripts/generate-pwa-icons.js",
    "pwa:sw": "npx workbox generateSW workbox-config.js",
    "test": "jest --config jest.config.js --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint js/ --ext .js",
    "lint:fix": "eslint js/ --ext .js --fix",
    "lint:html": "npx html-validate '**/*.html' --ignore 'node_modules/**,dist/**'",
    "format": "prettier --write '**/*.{js,html,css,json,md}' --ignore-path .gitignore",
    "format:check": "prettier --check '**/*.{js,html,css,json,md}' --ignore-path .gitignore",
    "validate": "node scripts/validate-project.js",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "outdated": "npm outdated",
    "clean": "rm -rf dist/ .cache/ coverage/",
    "clean:all": "npm run clean && rm -rf node_modules/ package-lock.json",
    "backup": "node scripts/backup.js",
    "deploy": "bash scripts/deploy.sh",
    "deploy:production": "bash scripts/deploy.sh production",
    "report": "node scripts/generate-report.js",
    "analyze": "npx source-map-explorer dist/js/*.js --html dist/analysis.html",
    "preversion": "npm test",
    "version": "npm run build && git add -A dist",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "e-arsip",
    "digital-archive",
    "document-management",
    "surat-menyurat",
    "arsip-digital",
    "pwa",
    "offline-first",
    "enterprise",
    "google-apps-script"
  ],
  "author": {
    "name": "E-Arsip Digital Team",
    "email": "dev@e-arsip.example.com",
    "url": "https://e-arsip.example.com"
  },
  "contributors": [
    {
      "name": "Development Team",
      "email": "dev@e-arsip.example.com"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/e-arsip-digital.git"
  },
  "bugs": {
    "url": "https://github.com/username/e-arsip-digital/issues"
  },
  "homepage": "https://e-arsip.example.com",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all",
      "not IE 11",
      "not android <= 4.4",
      "ios >= 14",
      "android >= 8"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "dexie": "^4.0.8",
    "dompurify": "^3.2.3"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^29.7.0",
    "clean-css-cli": "^5.6.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^8.24.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-explorer": "^2.5.3",
    "terser": "^5.37.0",
    "workbox-cli": "^7.3.0"
  },
  "overrides": {
    "dompurify": {
      "dompurify": "$dompurify"
    }
  },
  "packageManager": "npm@10.0.0"
}