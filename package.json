{
  "name": "e-arsip-digital",
  "version": "2026.1.0",
  "description": "Sistem Manajemen Arsip Digital Modern - Digital Archive Management System",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "npx http-server -p 8080 -c-1 --cors",
    "start": "npx http-server -p 8080",
    "build": "npm run minify && npm run optimize",
    "minify": "npm run minify:js && npm run minify:css && npm run minify:html",
    "minify:js": "terser js/*.js js/**/*.js -o dist/js/ -c -m",
    "minify:css": "cleancss -o dist/css/ css/*.css",
    "minify:html": "html-minifier --input-dir . --output-dir dist --file-ext html",
    "optimize": "npm run optimize:images && npm run generate:pwa",
    "optimize:images": "imagemin icons/*.{jpg,png,gif,svg} dist/icons/",
    "generate:pwa": "workbox generateSW workbox-config.js",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "cypress run",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint . --ext .js,.html",
    "lint:fix": "eslint . --ext .js,.html --fix",
    "format": "prettier --write .",
    "validate": "node scripts/validate-project.js",
    "security:audit": "npm audit && snyk test",
    "security:scan": "retire --path .",
    "backup": "node scripts/backup.js",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "deploy:production": "bash scripts/deploy.sh production",
    "deploy:safe": "bash scripts/deploy-safe.sh",
    "docker:build": "docker build -t e-arsip-digital:2026.1.0 .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "analyze": "webpack-bundle-analyzer stats.json",
    "report": "node scripts/generate-report.js",
    "clean": "rm -rf dist/ node_modules/ .cache/",
    "preversion": "npm test",
    "version": "npm run build && git add -A dist",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "e-arsip",
    "digital-archive",
    "document-management",
    "surat-menyurat",
    "arsip-digital",
    "pwa",
    "offline-first"
  ],
  "author": {
    "name": "E-Arsip Digital Team",
    "email": "dev@e-arsip.example.com",
    "url": "https://e-arsip.example.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/e-arsip-digital.git"
  },
  "bugs": {
    "url": "https://github.com/username/e-arsip-digital/issues"
  },
  "homepage": "https://e-arsip.example.com",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all",
      "not IE 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "clean-css-cli": "^5.6.3",
    "cypress": "^13.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-html": "^8.1.0",
    "html-minifier": "^4.0.0",
    "http-server": "^14.1.1",
    "imagemin-cli": "^7.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.0",
    "terser": "^5.27.0",
    "webpack-bundle-analyzer": "^4.10.0",
    "workbox-cli": "^7.0.0"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "dexie": "^3.2.6",
    "dompurify": "^3.0.8",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "qrcode": "^1.5.3",
    "socket.io-client": "^4.7.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  }
}