  "shortcuts": [
    {
      "name": "Surat Baru",
      "short_name": "Buat Surat",
      "description": "Buat surat keluar baru",
      "url": "/surat-keluar/form.html",
      "icons": [
        {
          "src": "/icons/shortcut-add.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Cari Surat",
      "short_name": "Cari",
      "description": "Cari surat masuk atau keluar",
      "url": "/search",
      "icons": [
        {
          "src": "/icons/shortcut-search.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Notifikasi",
      "short_name": "Notif",
      "description": "Lihat notifikasi terbaru",
      "url": "/notifikasi/index.html",
